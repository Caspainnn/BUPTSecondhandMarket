page {
  min-height: 100%;
  background: #f4f8fb;
  color: #17324d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx;
}

.card {
  padding: 36rpx;
  border: 1rpx solid #dbeaf4;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(37, 104, 151, 0.08);
}

.muted {
  color: #72808e;
}
