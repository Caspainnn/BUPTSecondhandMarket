.post-form{display:flex;flex-direction:column;gap:24rpx}.images{display:flex;flex-wrap:wrap;gap:16rpx}.image-item,.add-image{width:200rpx}.preview{width:200rpx;height:200rpx;border-radius:16rpx}.add-image{height:200rpx;border:2rpx dashed #83c7f4;background:#edf8ff;color:#2479b8;font-size:26rpx}.field{display:flex;flex-direction:column;gap:12rpx;font-size:28rpx}.field input,.field textarea,.picker{box-sizing:border-box;width:100%;border:1rpx solid #dbeaf4;border-radius:16rpx;background:#f9fcfe}.field input,.picker{height:88rpx;padding:0 22rpx;line-height:86rpx}.field textarea{height:220rpx;padding:22rpx;line-height:1.5}.mini{display:inline-flex;margin:6rpx 4rpx 0;padding:0 14rpx;font-size:22rpx;line-height:48rpx}.danger,.error{color:#c2413b}.submit{width:100%;border-radius:999rpx;background:#83c7f4;color:#17324d}.submit::after,.mini::after,.add-image::after{border:0}
