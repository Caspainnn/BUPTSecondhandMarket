.post-form{display:flex;flex-direction:column;gap:24rpx}
.images{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:16rpx}
.image-item,.add-image{box-sizing:border-box;position:relative;flex:0 0 calc((100% - 32rpx) / 3);width:calc((100% - 32rpx) / 3);height:0;padding:0;padding-bottom:calc((100% - 32rpx) / 3);margin:0}
.image-item{position:relative}
.preview{position:absolute;top:0;left:0;width:100%;height:100%;border-radius:16rpx}
.add-image{line-height:1.4;border-radius:16rpx;border:0;background:#edf8ff;color:#2479b8;font-size:26rpx}
.field{display:flex;flex-direction:column;gap:12rpx;font-size:28rpx}
.field-heading{display:flex;align-items:center;gap:8rpx}
.required{color:#c2413b}
.field input,.field textarea,.picker{box-sizing:border-box;width:100%;border:1rpx solid #dbeaf4;border-radius:16rpx;background:#f9fcfe}
.field input,.picker{height:88rpx;padding:0 22rpx;line-height:86rpx}
.field textarea{height:220rpx;padding:22rpx;line-height:1.5}
.add-icon{font-size:56rpx;line-height:1}
.remove-image{position:absolute;top:-12rpx;right:-12rpx;left:auto;display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;margin:0;padding:0;border-radius:50%;background:transparent;color:#fff;font-size:38rpx;line-height:1;z-index:1}
.error{color:#c2413b}
.submit{width:100%;border-radius:999rpx;background:#83c7f4;color:#17324d}
.submit::after{border:0}

.add-content{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;border:2rpx dashed #83c7f4;border-radius:16rpx}
.remove-icon{width:44rpx;height:44rpx}
.dropdown-picker{display:flex;align-items:center;justify-content:space-between}
.dropdown-icon{width:32rpx;height:32rpx;flex-shrink:0}
