.post-form{display:flex;flex-direction:column;gap:24rpx}.images{display:flex;flex-wrap:wrap;gap:16rpx}.image-item,.add-image{box-sizing:border-box;flex:0 0 200rpx;width:200rpx;height:200rpx;margin:0}.image-item{position:relative}.preview{width:200rpx;height:200rpx;border-radius:16rpx}.add-image{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;padding:0;line-height:1.4;border-radius:16rpx;border:2rpx dashed #83c7f4;background:#edf8ff;color:#2479b8;font-size:26rpx}.field{display:flex;flex-direction:column;gap:12rpx;font-size:28rpx}.field input,.field textarea,.picker{box-sizing:border-box;width:100%;border:1rpx solid #dbeaf4;border-radius:16rpx;background:#f9fcfe}.field input,.picker{height:88rpx;padding:0 22rpx;line-height:86rpx}.field textarea{height:220rpx;padding:22rpx;line-height:1.5}.add-icon{font-size:56rpx;line-height:1}.remove-image{position:absolute;top:8rpx;right:8rpx;display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;margin:0;padding:0;border-radius:50%;background:rgba(23,50,77,0.75);color:#fff;font-size:38rpx;line-height:1;z-index:1}.error{color:#c2413b}.submit{width:100%;border-radius:999rpx;background:#83c7f4;color:#17324d}.submit::after,.remove-image::after,.add-image::after{border:0}
