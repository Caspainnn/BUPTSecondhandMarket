.support{margin-top:12rpx;padding:22rpx;border-radius:14rpx;background:#f8fbfe;border:1rpx solid #e0ebf3;color:#17324d;font-weight:400}.results{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:22rpx;padding-bottom:18rpx;border-bottom:1rpx solid #e0ebf3;font-size:24rpx;color:#53677a}.results .feedback{flex:1;min-width:160rpx}.caption,.person,.hint{display:block}.caption{font-size:22rpx;color:#72808e}.person{margin-top:6rpx;font-size:25rpx;font-weight:500}.contact{display:flex;align-items:center;gap:16rpx;margin-top:8rpx;font-size:25rpx}.contact text{flex:1;min-width:0;word-break:break-all}.contact button{box-sizing:border-box;flex:0 0 88rpx;width:88rpx;min-width:0;max-width:88rpx;height:48rpx;margin:0;padding:0;line-height:48rpx;font-size:23rpx;border-radius:10rpx;color:#2479b8;background:#e4f4ff}.contact button::after{border:0}.hint{margin-top:20rpx;font-size:23rpx;color:#72808e;line-height:1.8}.security{display:flex;flex-wrap:wrap;margin-top:10rpx;font-size:24rpx;color:#53677a}.number{color:#2479b8;padding:0 8rpx}

.result-success{color:#16804a}.result-failure{color:#c2413b}.result-pending{color:#72808e}
