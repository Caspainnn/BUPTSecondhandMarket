.form-card, label { display: flex; flex-direction: column; gap: 14rpx; }.form-card { gap: 28rpx; }.snapshot { display: flex; gap: 20rpx; align-items: center; }.snapshot image { width: 110rpx; height: 110rpx; border-radius: 16rpx; }.snapshot view { display: flex; flex-direction: column; gap: 10rpx; }.price { color: #e66b45; }.picker, input { padding: 20rpx; border-radius: 14rpx; background: #f2f7fa; }.date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.hint { color: #72808e; font-size: 23rpx; }.error { color: #c2413b; }.form-card button { border-radius: 999rpx; background: #83c7f4; }.form-card button::after { border: 0; }
