<view class="page"><view class="card form-card">
  <view wx:if="{{conversation}}" class="snapshot"><image src="{{conversation.postSnapshot.coverFileId}}" mode="aspectFill" /><view><text>{{conversation.postSnapshot.title}}</text><text class="price">参考单价 ¥{{conversation.postSnapshot.unitPriceCents / 100}}</text></view></view>
  <label><text>数量</text><input data-field="quantity" type="number" value="{{form.quantity}}" bindinput="patch" /></label>
  <label><text>校区</text><picker range="{{campuses}}" range-key="name" bindchange="pickCampus"><view class="picker dropdown-picker"><text>{{campusName}}</text><image class="dropdown-icon" src="/assets/icons/dropdown.svg" mode="aspectFit" /></view></picker></label>
  <label><text>具体交接地点</text><input data-field="locationText" maxlength="50" value="{{form.locationText}}" placeholder="例如：图书馆南门" bindinput="patch" /></label>
  <view class="date-row"><label><text>日期</text><picker mode="date" value="{{date}}" bindchange="pickDate"><view class="picker dropdown-picker"><text>{{date}}</text><image class="dropdown-icon" src="/assets/icons/dropdown.svg" mode="aspectFit" /></view></picker></label><label><text>时间</text><picker mode="time" value="{{time}}" bindchange="pickTime"><view class="picker dropdown-picker"><text>{{time}}</text><image class="dropdown-icon" src="/assets/icons/dropdown.svg" mode="aspectFit" /></view></picker></label></view>
  <text class="hint">约定时间须晚于当前至少 10 分钟，且不超过 14 天</text><text wx:if="{{error}}" class="error">{{error}}</text>
  <button loading="{{status === 'submitting'}}" disabled="{{status === 'submitting'}}" bindtap="submit">提交给卖家确认</button>
</view></view>
