<view class="page"><view wx:if="{{status === 'loading'}}" class="card">正在加载原信息…</view><view wx:elif="{{status === 'error'}}" class="card">{{error}}</view><view wx:else class="card"><post-form editing="{{!republishing}}" form="{{form}}" status="{{status}}" error="{{error}}" submit-text="{{republishing ? '确认上架' : '保存修改'}}" bindpatch="onPatch" bindaddimages="onAddImages" bindremoveimage="onRemoveImage" bindmoveimage="onMoveImage" bindfailure="onFailure" bindsubmit="submit" /></view></view>
