<view class="page messages-page">
  <view wx:if="{{state === 'loading'}}" class="card empty">正在加载消息…</view>
  <view wx:elif="{{state === 'error'}}" class="card empty error"><text>{{error}}</text><button bindtap="retry">重试</button></view>
  <view wx:elif="{{!conversations.length}}" class="card empty"><text>还没有商品会话</text><text class="muted">从商品详情联系卖家后，会话会出现在这里</text></view>
  <view wx:else class="conversation-list">
    <view wx:for="{{conversations}}" wx:key="_id" class="conversation" data-id="{{item._id}}" bindtap="openConversation">
      <cloud-image class="avatar" src="{{item.peer.avatarFileId}}" mode="aspectFill" />
      <view class="content"><view class="top"><text class="name">{{item.peer.nickname}}</text><text class="post-title">{{item.postSnapshot.title}}</text></view><text class="preview">{{item.lastMessageText || '开始聊聊这件商品吧'}}</text></view>
      <text wx:if="{{item.unread}}" class="unread {{item.unread < 10 ? 'unread-single' : ''}}">{{item.unread > 99 ? '99+' : item.unread}}</text>
    </view>
  </view>
</view>
