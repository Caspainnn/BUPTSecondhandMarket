<view class="chat-page">
  <view class="seller-bar">
    <cloud-image class="seller-avatar" src="{{conversation.sellerSnapshot.avatarFileId}}" mode="aspectFill" />
    <view class="seller-details"><text class="seller-name">{{conversation.sellerSnapshot.nickname || '卖家'}}</text><text class="seller-label">卖家</text></view>
  </view>
  <view class="product-bar">
    <view wx:if="{{conversation}}" class="product-info" bindtap="openPost">
      <cloud-image wx:if="{{!imageError}}" class="product-cover" src="{{conversation.postSnapshot.coverFileId}}" mode="aspectFill" binderror="onImageError" />
      <view wx:else class="product-cover image-placeholder"></view>
      <view class="product-text"><text class="product-title">{{conversation.postSnapshot.title}}</text><text class="product-price">¥{{conversation.postSnapshot.unitPriceCents / 100}}</text></view>
    </view>
    <text wx:else class="product-title">正在获取商品信息</text>
    <view wx:if="{{canCreateTransaction}}" class="transaction-entry" aria-role="button" bindtap="createTransaction">预约购买</view>
  </view>
  <scroll-view class="messages" scroll-y scroll-with-animation scroll-into-view="bottom-anchor" upper-threshold="80" bindscrolltoupper="loadOlder">
    <view wx:if="{{loading}}" class="loading">正在加载…</view>
    <view wx:for="{{messages}}" wx:key="_id" class="message-row {{item.mine ? 'mine' : ''}}">
      <view wx:if="{{item.transactionCard}}" class="transaction-card">
        <view class="transaction-card-heading"><text>预约清单</text><text class="transaction-card-status">{{item.transactionCard.statusLabel}}</text></view>
        <text class="transaction-card-title">{{item.transactionCard.postSnapshot.title}}</text>
        <text class="transaction-key">数量：{{item.transactionCard.quantity}} 件</text>
        <text class="transaction-key">地点：{{item.transactionCard.campusName}} · {{item.transactionCard.locationText}}</text>
        <text class="transaction-key">时间：{{item.transactionCard.scheduledText}}</text>
        <text class="transaction-card-event">{{item.text}}</text>
        <view wx:if="{{item.canRespond || item.canRevise}}" class="card-actions">
          <button wx:if="{{item.canRespond}}" data-id="{{item.transactionId}}" data-action="confirm" disabled="{{cardBusy}}" catchtap="actOnCard">接受</button>
          <button wx:if="{{item.canRespond}}" class="card-secondary" data-id="{{item.transactionId}}" data-action="reject" disabled="{{cardBusy}}" catchtap="actOnCard">拒绝</button>
          <button wx:if="{{item.canRevise}}" class="card-secondary" data-id="{{item.transactionId}}" data-action="withdraw" disabled="{{cardBusy}}" catchtap="actOnCard">撤回</button>
          <button wx:if="{{item.canRevise}}" data-message="{{item._id}}" disabled="{{cardBusy}}" catchtap="editCard">修改</button>
        </view>
        <view wx:if="{{editingMessageId === item._id && item.canRevise}}" class="card-editor">
          <label><text>数量</text><input type="number" data-field="quantity" value="{{editForm.quantity}}" disabled="{{cardBusy}}" bindinput="patchCardEdit" /></label>
          <label><text>校区</text><picker range="{{campuses}}" range-key="name" value="{{editForm.campusIndex}}" data-field="campusIndex" disabled="{{cardBusy}}" bindchange="patchCardEdit"><view>{{campuses[editForm.campusIndex].name}}<image class="card-dropdown" src="/assets/icons/dropdown.svg" /></view></picker></label>
          <label><text>交接地点</text><input data-field="locationText" maxlength="50" value="{{editForm.locationText}}" disabled="{{cardBusy}}" bindinput="patchCardEdit" /></label>
          <label><text>日期</text><picker mode="date" value="{{editForm.date}}" data-field="date" disabled="{{cardBusy}}" bindchange="patchCardEdit"><view>{{editForm.date}}<image class="card-dropdown" src="/assets/icons/dropdown.svg" /></view></picker></label>
          <label><text>时间</text><picker mode="time" value="{{editForm.time}}" data-field="time" disabled="{{cardBusy}}" bindchange="patchCardEdit"><view>{{editForm.time}}<image class="card-dropdown" src="/assets/icons/dropdown.svg" /></view></picker></label>
          <view class="card-actions"><button loading="{{cardBusy}}" disabled="{{cardBusy}}" catchtap="saveCardEdit">保存修改</button><button class="card-secondary" disabled="{{cardBusy}}" catchtap="cancelCardEdit">取消修改</button></view>
        </view>
        <text class="transaction-card-link" data-id="{{item.transactionId}}" bindtap="openTransaction">查看预约详情 ›</text>
      </view>
      <view wx:elif="{{item.type === 'system'}}" class="system-message">{{item.text}}</view>
      <view wx:else class="bubble">{{item.text}}</view>
    </view>
    <view id="bottom-anchor"></view>
  </scroll-view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <view class="composer"><textarea value="{{draft}}" maxlength="500" placeholder="输入消息" bindinput="onDraft" /><button class="send-button" aria-label="发送消息" loading="{{sending}}" disabled="{{sending || !draft}}" bindtap="submit"><image class="send-icon" src="/assets/icons/send.svg" mode="aspectFit" /></button></view>
</view>
