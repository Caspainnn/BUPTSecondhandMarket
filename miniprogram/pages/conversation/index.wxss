page { height: 100%; overflow: hidden; background: #fff; }
.chat-page { box-sizing: border-box; display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fff; }
.transaction-entry { flex-shrink: 0; align-self: flex-end; box-sizing: border-box; width: 200rpx; min-width: 0; max-width: 200rpx; text-align: center; height: 45rpx; line-height: 45rpx; margin: 0; padding: 0 4rpx; white-space: nowrap; border-radius: 999rpx; background: #e4f4ff; color: #2479b8; font-size: 25rpx; }.transaction-entry::after { border: 0; }
.messages { box-sizing: border-box; flex: 1; height: 0; min-height: 0; padding: 24rpx; background: #f4f8fb; }
.message-row { display: flex; margin: 16rpx 0; justify-content: flex-start; }
.message-row.mine { justify-content: flex-end; }
.bubble { max-width: 72%; padding: 18rpx 24rpx; border-radius: 24rpx 24rpx 24rpx 6rpx; background: #fff; color: #17324d; font-size: 28rpx; line-height: 1.55; word-break: break-all; }
.mine .bubble { border-radius: 24rpx 24rpx 6rpx 24rpx; background: #83c7f4; }
.system-message { width: 100%; color: #72808e; font-size: 23rpx; text-align: center; }
.composer { flex-shrink: 0; display: flex; align-items: center; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; }
.composer textarea { box-sizing: border-box; height: 80rpx; min-height: 80rpx; max-height: 80rpx; line-height: 36rpx; flex: 1; padding: 22rpx 18rpx; border-radius: 18rpx; background: #f0f5f8; font-size: 27rpx; }
.composer button { width: 128rpx; margin: 0; border-radius: 999rpx; background: #83c7f4; font-size: 26rpx; }
.composer button::after { border: 0; }
.error, .loading { display: block; color: #c2413b; font-size: 23rpx; text-align: center; }

.product-bar{flex-shrink:0;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:16rpx;height:140rpx;padding:20rpx 24rpx;background:#fff;border-bottom:1rpx solid #dbeaf4}
.product-info{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0}
.product-cover{width:96rpx;height:96rpx;flex-shrink:0;border-radius:14rpx;background:#e4f4ff}
.product-text{display:flex;flex-direction:column;gap:12rpx;min-width:0}
.product-title{font-size:28rpx;color:#17324d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.product-price{font-size:24rpx;color:#e66b45}
.image-placeholder{display:flex;align-items:center;justify-content:center;text-align:center;font-size:20rpx;color:#72808e}
.composer .send-button{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;padding:0;border-radius:16rpx;background:transparent}
.send-icon{width:56rpx;height:56rpx}
.send-button[disabled] .send-icon{opacity:.35}

.seller-bar{flex-shrink:0;box-sizing:border-box;display:flex;align-items:center;gap:16rpx;height:112rpx;padding:20rpx 24rpx;background:#fff;border-bottom:1rpx solid #edf3f7}
.seller-avatar{width:72rpx;height:72rpx;flex-shrink:0;border-radius:50%;background:#e4f4ff}
.seller-details{display:flex;flex-direction:column;gap:6rpx;min-width:0}
.seller-name{font-size:28rpx;color:#17324d;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.seller-label{font-size:22rpx;color:#72808e}
.transaction-card{box-sizing:border-box;display:flex;flex-direction:column;gap:14rpx;width:100%;padding:24rpx;border:1rpx solid #dbeaf4;border-radius:20rpx;background:#fff;color:#3f5568;font-size:25rpx;line-height:1.5}
.transaction-card-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#17324d;font-size:28rpx;font-weight:600}
.transaction-card-status{font-size:23rpx;color:#2479b8}
.transaction-card-title{font-weight:600;color:#17324d}
.transaction-card-event{color:#72808e;font-size:23rpx}
.transaction-card-link{padding-top:12rpx;border-top:1rpx solid #edf3f7;color:#2479b8;font-size:24rpx}
.transaction-key{font-weight:600;color:#17324d}
.card-actions{display:flex;gap:16rpx}
.card-actions button{flex:1;margin:0;padding:0 12rpx;line-height:64rpx;border-radius:14rpx;background:#83c7f4;color:#17324d;font-size:25rpx}
.card-actions button::after{border:0}
.card-actions .card-secondary{background:#edf4f8;color:#3f5568}
.card-editor{display:flex;flex-direction:column;gap:16rpx;padding:20rpx;border-radius:16rpx;background:#f4f8fb}
.card-editor label{display:flex;flex-direction:column;gap:8rpx}
.card-editor input,.card-editor picker view{box-sizing:border-box;height:72rpx;padding:0 16rpx;line-height:72rpx;border-radius:12rpx;background:#fff}
.card-editor picker view{display:flex;align-items:center;justify-content:space-between}
.card-dropdown{width:28rpx;height:28rpx}.composer textarea{min-width:0;width:0}
.keyboard-open .composer{padding-bottom:18rpx}
.keyboard-open .composer textarea{height:144rpx;min-height:144rpx;max-height:144rpx;padding:18rpx;line-height:36rpx}
.bottom-anchor{height:1rpx}
