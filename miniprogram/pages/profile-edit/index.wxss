.edit-state {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.state-title {
  font-size: 36rpx;
  font-weight: 600;
}

.avatar-picker {
  position: relative;
  align-self: center;
  box-sizing: border-box;
  flex: 0 0 168rpx;
  width: 168rpx;
  height: 168rpx;
  margin: 16rpx auto;
  overflow: hidden;
  border-radius: 50%;
  background: #edf8ff;
}

.avatar-visual {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-empty {
  border: 2rpx dashed #83c7f4;
  color: #2479b8;
  font-size: 24rpx;
}

.avatar-button {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
}

.avatar-button::after {
  border: 0;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
}

.input,
.picker {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 24rpx;
  border: 1rpx solid #dbeaf4;
  border-radius: 18rpx;
  background: #f9fcfe;
  font-size: 28rpx;
}

.placeholder {
  color: #9aa8b5;
}

.error-text {
  color: #c2413b;
  font-size: 26rpx;
}

.primary-button {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #83c7f4;
  color: #17324d;
  font-size: 28rpx;
}

.primary-button::after {
  border: 0;
}

.retry-button {
  width: 100%;
  border: 1rpx solid #83c7f4;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2479b8;
  font-size: 28rpx;
}

.retry-button::after {
  border: 0;
}
