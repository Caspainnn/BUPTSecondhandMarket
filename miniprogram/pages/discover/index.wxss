.discover-page { padding: 32rpx 24rpx 48rpx; }
.toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.heading, .subheading { display: block; }
.heading { font-size: 42rpx; font-weight: 700; }
.subheading { margin-top: 6rpx; color: #72808e; font-size: 24rpx; }
.campus-picker { padding: 16rpx 22rpx; border-radius: 999rpx; background: #e4f4ff; color: #2479b8; font-size: 26rpx; }
.post-grid { position: relative; width: 100%; }
.post-card { position: absolute; width: calc((100% - 20rpx) / 2); overflow: hidden; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(37, 104, 151, .08); }
.cover { width: 100%; height: 300rpx; background: #dfeef7; }
.post-body { display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx; }
.post-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 28rpx; font-weight: 600; line-height: 1.45; word-break: break-all; }
.post-description { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; color: #72808e; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.price { color: #e66b45; font-size: 30rpx; font-weight: 700; }
.meta { color: #72808e; font-size: 22rpx; }
.state-card { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 80rpx 24rpx; border-radius: 24rpx; background: #fff; color: #53677a; text-align: center; }
.state-card button { width: 220rpx; border-radius: 999rpx; background: #83c7f4; font-size: 26rpx; }
.state-card button::after { border: 0; }
.error { color: #c2413b; }
.footer-note { padding: 36rpx 0 12rpx; color: #8896a3; font-size: 24rpx; text-align: center; }

.dropdown-picker{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.dropdown-icon{width:32rpx;height:32rpx;flex-shrink:0}
.type-tag { display:block; color:#64748b; font-size:22rpx; margin-bottom:8rpx; }
.filter-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx;color:#72808e;font-size:26rpx}
.filter-trigger{display:flex;align-items:center;justify-content:center;flex:0 0 auto;gap:8rpx;margin:0 0 0 auto;padding:0 18rpx;width:112rpx;height:58rpx;box-sizing:border-box;border-radius:999rpx;background:#e4f4ff;color:#2479b8;font-size:24rpx}
.sort-picker{padding:8rpx 0;color:#53677a;font-size:26rpx}
.filter-icon{width:32rpx;height:32rpx;flex-shrink:0}
.filter-trigger::after,.filter-sheet button::after{border:0}
.filter-mask{position:fixed;inset:0;z-index:1000;background:rgba(23,50,77,.35);display:flex;align-items:flex-end}
.filter-sheet{width:100%;box-sizing:border-box;padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#fff}
.sheet-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;font-size:34rpx;font-weight:600}
.close-filter{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:0 0 56rpx;margin:0;width:56rpx;height:56rpx;padding:0;border:1rpx solid #dbeaf4;border-radius:16rpx;background:transparent;color:#72808e;font-size:32rpx;line-height:1}
.filter-scroll{max-height:60vh}
.filter-group{margin-bottom:24rpx}
.filter-heading{display:block;margin-bottom:12rpx;font-size:28rpx}
.filter-options{display:flex;flex-wrap:wrap;gap:12rpx;width:100%}
.filter-option{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:0 0 calc((100% - 36rpx) / 4);width:calc((100% - 36rpx) / 4);min-width:0;height:64rpx;margin:0;padding:0 4rpx;border:1rpx solid #dbeaf4;background:#f9fcfe;border-radius:16rpx;color:#53677a;font-size:24rpx;line-height:1.3;white-space:nowrap}
.filter-option.selected{border-color:#a5d7f7;background:#a5d7f7;color:#17324d}
.filter-trigger.selected{background:#a5d7f7;color:#17324d}
.filter-actions{display:flex;gap:20rpx;padding-top:4rpx}
.filter-actions button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:1;width:0;min-width:0;height:80rpx;margin:0;padding:0 16rpx;border:1rpx solid #dbeaf4;background:transparent;border-radius:22rpx;color:#17324d;font-size:28rpx;line-height:1.3}
.filter-actions .apply-filter{flex:2;background:#83c7f4;color:#17324d}

.filter-bar{justify-content:flex-start;gap:24rpx;font-size:24rpx}.campus-control,.sort-control{flex:0 0 auto;min-width:0}.filter-bar .sort-picker{justify-content:flex-start;gap:4rpx;font-size:24rpx;min-height:58rpx;box-sizing:border-box}.filter-bar .sort-picker text{white-space:nowrap}.filter-bar .dropdown-icon{width:22rpx;height:22rpx}.filter-bar .filter-trigger{flex:0 0 auto;margin-left:auto;width:100rpx;padding:0 10rpx;gap:6rpx}.filter-bar .filter-icon{width:26rpx;height:26rpx}.price-sort{display:flex;align-items:center;justify-content:flex-start;gap:4rpx;flex:0 0 auto;height:58rpx;color:#53677a}.price-arrows{display:flex;flex-direction:column;color:#a4afb8;font-size:22rpx;line-height:16rpx}.price-sort.active,.price-arrows .active{color:#2479b8}

.search-bar{display:flex;align-items:center;gap:12rpx;margin-bottom:24rpx;padding:8rpx 16rpx;border:1rpx solid #dbeaf4;border-radius:20rpx;background:#fff}.search-bar input{flex:1;min-width:0;height:64rpx;font-size:26rpx}.clear-search{display:flex;align-items:center;justify-content:center;flex:0 0 56rpx;height:64rpx;font-size:34rpx;color:#72808e}.search-action{display:flex;align-items:center;justify-content:center;flex:0 0 80rpx;height:64rpx;font-size:26rpx;color:#2479b8}

.price-range{display:flex;align-items:center;gap:16rpx}.price-range input{flex:1;min-width:0;height:76rpx;padding:0 20rpx;border:1rpx solid #dbeaf4;border-radius:16rpx;background:#f9fcfe;font-size:26rpx}.filter-hint{display:block;margin-top:12rpx;color:#72808e;font-size:22rpx;line-height:1.5}.condition-options .filter-option{flex-basis:calc((100% - 12rpx) / 2);width:calc((100% - 12rpx) / 2);white-space:normal;padding:8rpx;height:auto;min-height:64rpx}
