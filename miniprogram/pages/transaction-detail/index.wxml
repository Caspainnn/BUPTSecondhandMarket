<view class="page">
  <view wx:if="{{state === 'loading'}}" class="card state">正在加载交易…</view><view wx:elif="{{state === 'error'}}" class="card state error">{{error}}</view>
  <block wx:else><view class="card detail"><view class="headline"><text>{{transaction.postSnapshot.title}}</text><text class="status status-{{transaction.status}}">{{statusLabel}}</text></view><text wx:if="{{transaction.postSnapshot.contentType !== 'service'}}">数量：{{transaction.quantity}}</text><text wx:if="{{transaction.postSnapshot.unitPriceCents != null}}">参考价格：¥{{transaction.postSnapshot.unitPriceCents / 100}}</text><text>买家昵称：{{buyerNickname}}</text><text>卖家昵称：{{sellerNickname}}</text><text>约定时间：{{scheduledText}}</text><text wx:if="{{autoCompleteText}}">无失败反馈将于 {{autoCompleteText}} 自动完成</text><text wx:if="{{transaction.itemDescription}}">物品说明：{{transaction.itemDescription}}</text><text>{{transaction.fulfillmentMode === 'online' ? '线上交付方式' : '交接地点'}}：{{transaction.locationText}}</text><text wx:if="{{transaction.status !== 'failed' && transaction.status !== 'abnormal'}}">买家结果：{{buyerResultText}}</text><text wx:if="{{transaction.status !== 'failed' && transaction.status !== 'abnormal'}}">卖家结果：{{sellerResultText}}</text><transaction-help transaction="{{transaction}}" peer="{{peerContact}}" /></view>
  <view wx:if="{{actions.length}}" class="actions"><button class="{{item === 'confirm' || item === 'success' ? 'action-primary' : 'action-secondary'}}" wx:for="{{actions}}" wx:key="*this" data-action="{{item}}" loading="{{busy}}" bindtap="act">{{item === 'withdraw' ? '撤回' : item === 'confirm' ? (transaction.inventoryManaged === false ? '接受预约' : '确认并锁定库存') : item === 'reject' ? '拒绝' : item === 'cancel' ? '取消交易' : item === 'success' ? '交接成功' : '交接失败'}}</button></view>
  <view wx:if="{{subscription.enabled && canSubscribe}}" class="card subscription-entry"><button bindtap="subscribe" loading="{{subscribing}}" disabled="{{subscribing}}">{{subscriptionPending ? '重试保存订阅' : '订阅下一条预约提醒'}}</button><text>一次订阅可接收一条微信提醒，不影响预约操作。</text></view>
  <view wx:if="{{events.length}}" class="card timeline"><text class="section-title">状态记录</text><view wx:for="{{events}}" wx:key="_id" class="event"><text class="event-label">{{item.label}}</text><text class="event-time">{{item.timeText}}</text><text wx:if="{{item.reason}}" class="event-reason">原因：{{item.reason}}</text></view></view></block>
</view>
