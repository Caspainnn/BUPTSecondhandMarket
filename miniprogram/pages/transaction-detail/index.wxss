.state { text-align: center; }.error { color: #c2413b; }.detail { display: flex; flex-direction: column; gap: 18rpx; }.headline { display: flex; justify-content: space-between; gap: 20rpx; font-size: 34rpx; font-weight: 700; }.status { color: #2479b8; white-space: nowrap; }.status-failed,.status-abnormal { color: #c2413b; }.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0; }.actions button { flex: 1; min-width: 220rpx; border-radius: 999rpx; background: #83c7f4; font-size: 25rpx; }.actions button::after { border: 0; }.timeline { margin-top: 24rpx; }.section-title { font-size: 30rpx; font-weight: 600; }.event { padding: 18rpx 0; border-bottom: 1rpx solid #edf3f7; color: #53677a; }
