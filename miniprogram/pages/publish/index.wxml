<view class="page">
  <view class="publish-tabs">
    <button class="publish-tab {{activeTab === 'sell' ? 'active' : ''}}" disabled="{{status === 'saving' || status === 'uploading'}}" data-tab="sell" bindtap="switchTab">我提供</button>
    <button class="publish-tab {{activeTab === 'wanted' ? 'active' : ''}}" disabled="{{status === 'saving' || status === 'uploading'}}" data-tab="wanted" bindtap="switchTab">我需要</button>
  </view>
  <view class="card"><post-form form="{{form}}" status="{{status}}" error="{{error}}" bindpatch="onPatch" bindaddimages="onAddImages" bindremoveimage="onRemoveImage" bindmoveimage="onMoveImage" bindfailure="onFailure" bindsubmit="submit" /></view>
</view>
