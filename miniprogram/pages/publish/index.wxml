<view class="page">
  <view class="publish-tabs">
    <button class="publish-tab {{activeTab === 'sell' ? 'active' : ''}}" data-tab="sell" bindtap="switchTab">发闲置</button>
    <button class="publish-tab {{activeTab === 'wanted' ? 'active' : ''}}" data-tab="wanted" bindtap="switchTab">求购</button>
  </view>
  <view class="card" hidden="{{activeTab !== 'sell'}}">
    <post-form form="{{form}}" status="{{status}}" error="{{error}}" bindpatch="onPatch" bindaddimages="onAddImages" bindremoveimage="onRemoveImage" bindmoveimage="onMoveImage" bindfailure="onFailure" bindsubmit="submit" />
  </view>
  <view wx:if="{{activeTab === 'wanted'}}" class="card wanted-placeholder">
    <text class="wanted-title">求购功能后续开放</text>
    <text class="muted">未来可填写预算、期望程度和需求期限，并支持响应求购。</text>
    <text class="muted">当前暂不支持发布求购需求。</text>
  </view>
</view>
