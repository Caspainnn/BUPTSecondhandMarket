.profile-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  text-align: center;
}

.state-title {
  font-size: 36rpx;
  font-weight: 600;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #d9effd;
  color: #2479b8;
  font-size: 52rpx;
  font-weight: 700;
}

.error-text {
  color: #c2413b;
}

.secondary-button {
  width: 100%;
  margin-top: 20rpx;
  border: 1rpx solid #83c7f4;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2479b8;
  font-size: 28rpx;
}

.secondary-button::after {
  border: 0;
}

.avatar-picker{position:relative;width:144rpx;height:144rpx;flex-shrink:0;overflow:hidden;border-radius:50%}
.avatar-button{position:absolute;top:0;left:0;width:100%;height:100%;margin:0;padding:0;opacity:0}
.avatar-button::after{border:0}
.profile-field{display:flex;flex-direction:column;gap:12rpx;width:100%;text-align:left;font-size:28rpx}
.profile-input,.profile-picker{box-sizing:border-box;width:100%;height:88rpx;padding:0 22rpx;line-height:86rpx;border:1rpx solid #dbeaf4;border-radius:16rpx;background:#f9fcfe}
.profile-picker{display:flex;align-items:center;justify-content:space-between}
.dropdown-icon{width:32rpx;height:32rpx;flex-shrink:0}
.primary-button{width:100%;margin:0;border-radius:999rpx;background:#83c7f4;color:#17324d}
.primary-button::after{border:0}
.profile-links{margin-top:24rpx}
.avatar-empty{font-size:24rpx}
.profile-links{display:flex;justify-content:space-around;padding:24rpx}.profile-entry{display:flex;flex:1;flex-direction:column;align-items:center;gap:12rpx;font-size:25rpx;color:#53677a}.profile-entry image{width:72rpx;height:72rpx}.ongoing-heading{display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 12rpx;font-size:30rpx;font-weight:600}.all-orders{font-size:24rpx;font-weight:400;color:#2479b8}.ongoing-empty{display:block;text-align:center;padding:24rpx;color:#72808e;font-size:25rpx}

.profile-entry .transactions-entry-icon{width:48rpx;height:48rpx;margin:12rpx 0}
