<template name="ongoing-order">
<view class="order-card">
  <view class="heading"><text>{{transaction.postSnapshot.title}}</text><text class="status">{{statusLabel}}</text></view>
  <text class="role">{{transaction.buyerId === userId ? '我买的' : '我卖的'}}</text>
  <text class="key">数量：{{transaction.quantity}} 件</text>
  <text class="key">地点：{{campusName}} · {{transaction.locationText}}</text>
  <text class="key">时间：{{scheduledText}}</text>
  <view wx:if="{{actions.length || canEdit}}" class="actions"><button wx:for="{{actions}}" wx:key="*this" data-action="{{item}}" disabled="{{busy}}" data-id="{{transaction._id}}" bindtap="orderAct">{{item === 'confirm' ? '接受' : item === 'reject' ? '拒绝' : item === 'withdraw' ? '撤回' : '取消交易'}}</button><button wx:if="{{canEdit}}" disabled="{{busy}}" data-id="{{transaction._id}}" bindtap="orderEdit">修改</button></view>
  <view wx:if="{{canResult}}" class="actions"><button data-action="success" disabled="{{busy || successDisabled}}" data-id="{{transaction._id}}" bindtap="orderAct">交接成功</button><button data-action="failure" disabled="{{busy}}" data-id="{{transaction._id}}" bindtap="orderAct">交接失败</button></view>
  <text wx:if="{{canResult && successDisabled}}" class="hint">到约定时间后可确认交接成功</text>
  <text wx:if="{{waitingOther}}" class="hint">你已提交交接结果，等待对方确认</text>
  <view wx:if="{{editing && canEdit}}" class="editor">
    <label>数量<input type="number" value="{{form.quantity}}" data-field="quantity" data-id="{{transaction._id}}" bindinput="orderPatch" disabled="{{busy}}" /></label>
    <label>校区<picker range="{{campuses}}" range-key="name" value="{{form.campusIndex}}" data-field="campusIndex" data-id="{{transaction._id}}" bindchange="orderPatch" disabled="{{busy}}"><view>{{campuses[form.campusIndex].name}}<image src="/assets/icons/dropdown.svg" /></view></picker></label>
    <label>地点<input value="{{form.locationText}}" maxlength="50" data-field="locationText" data-id="{{transaction._id}}" bindinput="orderPatch" disabled="{{busy}}" /></label>
    <label>日期<picker mode="date" value="{{form.date}}" data-field="date" data-id="{{transaction._id}}" bindchange="orderPatch" disabled="{{busy}}"><view>{{form.date}}<image src="/assets/icons/dropdown.svg" /></view></picker></label>
    <label>时间<picker mode="time" value="{{form.time}}" data-field="time" data-id="{{transaction._id}}" bindchange="orderPatch" disabled="{{busy}}"><view>{{form.time}}<image src="/assets/icons/dropdown.svg" /></view></picker></label>
    <view class="actions"><button disabled="{{busy}}" loading="{{busy}}" data-id="{{transaction._id}}" bindtap="orderSave">保存修改</button><button disabled="{{busy}}" data-id="{{transaction._id}}" bindtap="orderCloseEdit">取消修改</button></view>
  </view>
  <text class="link" data-id="{{transaction._id}}" bindtap="orderOpen">查看预约详情 ›</text>
</view>

</template>
