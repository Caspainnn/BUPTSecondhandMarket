<import src="order-card.wxml" />
<view class="page">
  <view wx:if="{{state === 'loading'}}" class="card profile-state"><text class="state-title">个人资料</text><text class="muted">正在加载微信身份…</text></view>
  <view wx:elif="{{state === 'error'}}" class="card profile-state"><text class="error-text">{{message}}</text><button class="secondary-button" bindtap="retry">重试</button></view>
  <block wx:else>
    <view class="card profile-summary" bindtap="openProfileEdit" aria-role="button" aria-label="编辑个人资料">
      <cloud-image wx:if="{{user.avatarFileId}}" class="summary-avatar" src="{{user.avatarFileId}}" mode="aspectFill" />
      <view wx:else class="summary-avatar summary-empty">头像</view>
      <view class="summary-details"><text class="summary-nickname">{{user.nickname || '未设置昵称'}}</text><text class="summary-contact">{{user.contactType || '联系方式'}}：{{user.contactInfo || '未填写'}}</text><text class="summary-campus">{{campusIndex < 0 ? '未设置常驻校区' : campuses[campusIndex].name}}</text></view>
      <text class="summary-chevron">›</text>
    </view>
    <block wx:if="{{user.profileCompleted}}">
      <view class="card profile-links"><view class="profile-entry" bindtap="openMyPosts"><image src="/assets/icons/my-posts.svg" mode="aspectFit" /><text>我的发布</text></view><view class="profile-entry" bindtap="openMyTransactions"><image class="transactions-entry-icon" src="/assets/icons/my-transactions.png" mode="aspectFit" /><text>我的交易</text></view></view>
      <view class="ongoing-heading"><text>正在进行</text><text class="all-orders" bindtap="openAllOrders">全部订单 ›</text></view>
      <text wx:if="{{ongoingError}}" class="ongoing-empty" bindtap="loadOngoing">{{ongoingError}}</text>
      <text wx:elif="{{!ongoing.length}}" class="ongoing-empty">{{ongoingLoading ? '正在加载交易…' : '暂无正在进行的交易'}}</text>
      <block wx:for="{{ongoingViews}}" wx:key="id"><template is="ongoing-order" data="{{...item}}" /></block>
      <view wx:if="{{ongoingCursor}}" class="ongoing-empty" data-more="true" bindtap="loadOngoing">查看更多正在进行的交易</view>
    </block>
  </block>
</view>
