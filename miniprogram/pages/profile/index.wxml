<view class="page">
  <view wx:if="{{state === 'loading'}}" class="card profile-state">
    <text class="state-title">个人资料</text>
    <text class="muted">正在加载微信身份…</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="card profile-state">
    <text class="state-title">暂时无法加载</text>
    <text class="error-text">{{message}}</text>
    <button class="secondary-button" bindtap="retry">重试</button>
  </view>

  <view wx:else class="card profile-state">
    <image wx:if="{{user.avatarFileId}}" class="avatar" src="{{user.avatarFileId}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-empty">邮</view>
    <text class="state-title">{{user.nickname || '尚未完善资料'}}</text>
    <text class="muted">{{user.profileCompleted ? '资料已完善' : '完成头像、昵称和常驻校区后即可使用完整功能'}}</text>
    <button class="secondary-button" bindtap="editProfile">{{user.profileCompleted ? '修改资料' : '完善资料'}}</button>
  </view>
</view>
