<view class="page"><view class="tabs"><button class="{{role === 'buyer' ? 'active' : ''}}" data-role="buyer" bindtap="switchRole">我买到的</button><button class="{{role === 'seller' ? 'active' : ''}}" data-role="seller" bindtap="switchRole">我卖出的</button></view><view wx:if="{{state === 'loading'}}" class="card empty">正在加载…</view><view wx:elif="{{state === 'error'}}" class="card empty error">{{error}}</view><view wx:elif="{{!transactions.length}}" class="card empty">{{roleName}}暂无交易</view><view wx:else class="list"><view wx:for="{{transactions}}" wx:key="_id" class="card item" data-id="{{item._id}}" bindtap="open"><cloud-image src="{{item.postSnapshot.coverFileId}}" mode="aspectFill" /><view><text class="title">{{item.postSnapshot.title}}</text><text>{{item.statusLabel}}</text><text>{{item.scheduledText}}</text></view></view><view wx:if="{{nextCursor}}" class="empty" bindtap="more">加载更多</view></view></view>
