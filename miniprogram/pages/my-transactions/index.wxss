.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }.tabs button { flex: 1; border-radius: 999rpx; background: #fff; color: #72808e; font-size: 26rpx; }.tabs button.active { background: #83c7f4; color: #17324d; }.tabs button::after { border: 0; }.list { display: flex; flex-direction: column; gap: 20rpx; }.item { display: flex; align-items: center; gap: 22rpx; padding: 24rpx; }.item cloud-image { width: 130rpx; height: 130rpx; border-radius: 18rpx; }.item view { display: flex; flex-direction: column; gap: 12rpx; color: #72808e; font-size: 23rpx; }.title { color: #17324d; font-size: 29rpx; font-weight: 600; }.empty { text-align: center; }.error { color: #c2413b; }
