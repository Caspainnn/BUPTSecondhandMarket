.list { display: flex; flex-direction: column; gap: 20rpx; }.item { display: flex; gap: 22rpx; padding: 24rpx; }.item cloud-image { width: 160rpx; height: 160rpx; flex: none; border-radius: 18rpx; }.body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 15rpx; color: #72808e; font-size: 23rpx; }.title { color: #17324d; font-size: 29rpx; font-weight: 600; }.buttons { display: flex; gap: 12rpx; margin-top: 20rpx; }.buttons button { flex: 1; min-width: 0; margin: 0; padding: 0 28rpx; border-radius: 999rpx; background: #e4f4ff; color: #2479b8; font-size: 23rpx; }.buttons button::after { border: 0; }.empty { text-align: center; }.error { color: #c2413b; }

.buttons .action-primary{border:1rpx solid #83c7f4;background:#83c7f4;color:#17324d}.buttons .action-secondary{border:1rpx solid #c6dce9;background:#f9fcfe;color:#53677a}

.buttons{gap:16rpx;margin-top:16rpx;flex-wrap:wrap}.buttons button{display:flex;align-items:center;justify-content:center;height:72rpx;line-height:1.4;padding:0 24rpx;border-radius:16rpx;font-size:25rpx;font-weight:500}.buttons .action-primary{background:#e4f4ff;border:1rpx solid #b8def6;color:#17486b}.buttons .action-secondary{background:#fff;border:1rpx solid #d5e3ed;color:#53677a}
