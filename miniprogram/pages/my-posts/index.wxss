.list { display: flex; flex-direction: column; gap: 20rpx; }.item { display: flex; gap: 22rpx; padding: 24rpx; }.item image { width: 160rpx; height: 160rpx; flex: none; border-radius: 18rpx; }.body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 15rpx; color: #72808e; font-size: 23rpx; }.title { color: #17324d; font-size: 29rpx; font-weight: 600; }.buttons { display: flex; gap: 12rpx; }.buttons button { margin: 0; padding: 0 24rpx; border-radius: 999rpx; background: #e4f4ff; color: #2479b8; font-size: 23rpx; }.buttons button::after { border: 0; }.empty { text-align: center; }.error { color: #c2413b; }
