<view class="page"><view wx:if="{{state === 'loading'}}" class="card empty">正在加载…</view><view wx:elif="{{state === 'error'}}" class="card empty error">{{error}}</view><view wx:elif="{{!posts.length}}" class="card empty">还没有发布商品</view><view wx:else class="list"><view wx:for="{{posts}}" wx:key="_id" class="card item"><image src="{{item.imageFileIds[0]}}" mode="aspectFill" data-id="{{item._id}}" bindtap="detail" /><view class="body"><text class="title">{{item.title}}</text><text>库存：可预约 {{item.availableQuantity}} / 预留 {{item.reservedQuantity}} / 已售 {{item.soldQuantity}}</text><view class="buttons"><button data-id="{{item._id}}" bindtap="edit">编辑</button><button wx:if="{{item.status === 'active' && item.availableQuantity > 0}}" data-id="{{item._id}}" data-status="offline" bindtap="status">下架</button><button wx:if="{{item.status === 'offline' && item.availableQuantity > 0}}" data-id="{{item._id}}" data-status="active" bindtap="status">上架</button></view></view></view></view></view>
