<view class="page"><view wx:if="{{state === 'loading'}}" class="card empty">正在加载…</view><view wx:elif="{{state === 'error'}}" class="card empty error">{{error}}</view><view wx:elif="{{!posts.length}}" class="card empty">还没有发布信息</view><view wx:else class="list"><view wx:for="{{posts}}" wx:key="_id" class="card item"><cloud-image wx:if="{{item.imageFileIds.length}}" src="{{item.imageFileIds[0]}}" mode="aspectFill" data-id="{{item._id}}" bindtap="detail" /><view class="body"><text>{{item.direction === 'need' ? '我需要' : '我提供'}} · {{item.contentType === 'service' ? '服务' : '物品'}}{{item.status === 'completed' ? ' · 已完成' : ''}}</text><text class="title">{{item.title}}</text><text wx:if="{{item.direction !== 'need' && item.contentType !== 'service'}}">库存：可预约 {{item.availableQuantity}} / 预留 {{item.reservedQuantity}} / 已售 {{item.soldQuantity}}</text><view class="buttons"><button class="{{item.status === 'offline' ? 'action-secondary' : 'action-primary'}}" data-id="{{item._id}}" bindtap="edit">编辑</button><button class="action-secondary" wx:if="{{item.status === 'active' && (item.direction === 'need' || item.contentType === 'service' || item.availableQuantity > 0)}}" data-id="{{item._id}}" data-status="offline" bindtap="status">{{item.direction === 'need' || item.contentType === 'service' ? '关闭' : '下架'}}</button><button class="action-primary" wx:if="{{item.status === 'offline' && (item.direction === 'need' || item.contentType === 'service' || item.availableQuantity > 0)}}" data-id="{{item._id}}" data-status="active" bindtap="status">{{item.direction === 'need' || item.contentType === 'service' ? '重新开放' : '上架'}}</button></view></view></view></view></view>
