.detail-page { padding: 0 0 160rpx; }
.gallery { width: 100%; height: 750rpx; background: #dfeef7; }
.gallery cloud-image { width: 100%; height: 100%; }
.info-card, .seller { margin: 24rpx; }
.title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.title { flex: 1; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.price { color: #e66b45; font-size: 36rpx; font-weight: 700; white-space: nowrap; }
.unavailable { display: block; margin-top: 20rpx; padding: 16rpx; border-radius: 12rpx; background: #fff3e8; color: #a6552f; font-size: 24rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0; }
.chips text { padding: 8rpx 16rpx; border-radius: 999rpx; background: #e4f4ff; color: #2479b8; font-size: 22rpx; }
.description { display: block; color: #3f5568; font-size: 29rpx; line-height: 1.8; white-space: pre-wrap; }
.defect { display: block; margin-top: 20rpx; color: #c2413b; }
.stock { display: block; margin-top: 24rpx; color: #72808e; font-size: 24rpx; }
.seller { display: flex; align-items: center; gap: 20rpx; }
.seller cloud-image { width: 72rpx; height: 72rpx; border-radius: 50%; background: #dfeef7; }
.contact { position: fixed; right: 24rpx; bottom: 36rpx; left: 24rpx; z-index: 2; }
.contact { flex: 1; border-radius: 999rpx; background: #83c7f4; color: #17324d; font-size: 28rpx; }
.contact::after { border: 0; }
.state { margin: 32rpx; text-align: center; }
.error { color: #c2413b; }
.contact.own-contact { background: #dce3e9; color: #8794a0; }